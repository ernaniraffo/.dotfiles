# Ghostty config (~/.config/ghostty/config.ghostty).
# Options: `ghostty +show-config --default --docs` or https://ghostty.org/docs/config
#
# Follows the macOS light/dark appearance. Keep in sync with the Neovim
# colorscheme in nvim/lua/eraffo/colors.lua. List themes: ghostty +list-themes
theme = light:Kanagawa Lotus,dark:Kanagawa Dragon
