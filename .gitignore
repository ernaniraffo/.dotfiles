# Neovim Plugins
nvim/.config/nvim/plugged/*

# macOS / editor junk
.DS_Store
*.un~

# ~/.config is a symlink to nvim/.config, so every app that writes there
# (gh, gcloud, copilot, ...) lands in this public repo. Ignore everything
# by default and only allow the configs we actually track.
nvim/.config/*
!nvim/.config/nvim/
!nvim/.config/yapf/
