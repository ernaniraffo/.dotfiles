# Docs: https://ghostty.org/docs/config
# Keep the theme in sync with nvim/lua/eraffo/colors.lua.
theme = light:Modus Operandi,dark:Modus Vivendi

# Skips the bash step Ghostty adds on macOS. Delete if you don't use zsh.
command = direct:/bin/zsh -l

# Drop-down terminal from any app (needs Accessibility permission).
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-animation-duration = 0

# Page Up/Down scroll the scrollback and still reach programs like Neovim.
keybind = unconsumed:page_up=scroll_page_up
keybind = unconsumed:page_down=scroll_page_down
# Otherwise each Page Up press jumps back to the bottom before scrolling.
scroll-to-bottom = no-keystroke
